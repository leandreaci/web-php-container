#!/bin/sh
set -e

if [ $# -eq 0 ]; then
    echo "Usage: install-php-extensions <ext1> [ext2 ...]"
    echo "Examples:"
    echo "  install-php-extensions oci8"
    echo "  install-php-extensions xdebug soap pgsql pdo_pgsql"
    echo "  install-php-extensions redis imagick swoole"
    exit 1
fi

PHP_BIN="$(command -v php85 || command -v php84 || command -v php83 || command -v php82 || command -v php81 || command -v php8 || command -v php7 || command -v php || echo /usr/bin/php)"
if [ ! -x "$PHP_BIN" ]; then
    echo "❌ PHP binary not found."
    exit 1
fi

PHP_MAJOR_MINOR="$($PHP_BIN -d disable_functions="" -r 'echo PHP_MAJOR_VERSION . "." . PHP_MINOR_VERSION;')"
CONF_DIR="$($PHP_BIN -d disable_functions="" -r 'echo PHP_CONFIG_FILE_SCAN_DIR;')"
mkdir -p "$CONF_DIR"

case "$PHP_MAJOR_MINOR" in
    7.3|7.4)
        APK_PHP_PREFIX="php7"
        PECL_BIN="$(command -v pecl || command -v pecl7 || echo /usr/bin/pecl)"
        PHPIZE_BIN="$(command -v phpize || command -v phpize7 || echo /usr/bin/phpize)"
        PHP_CONFIG_BIN="$(command -v php-config || command -v php-config7 || echo /usr/bin/php-config)"
        OCI8_PECL_SPEC="oci8-2.2.0"
        ;;
    8.0)
        APK_PHP_PREFIX="php8"
        PECL_BIN="$(command -v pecl8 || command -v pecl || echo /usr/bin/pecl8)"
        PHPIZE_BIN="$(command -v phpize8 || command -v phpize || echo /usr/bin/phpize8)"
        PHP_CONFIG_BIN="$(command -v php-config8 || command -v php-config || echo /usr/bin/php-config8)"
        OCI8_PECL_SPEC="oci8-3.0.1"
        ;;
    8.1)
        APK_PHP_PREFIX="php81"
        PECL_BIN="$(command -v pecl81 || command -v pecl || echo /usr/bin/pecl81)"
        PHPIZE_BIN="$(command -v phpize81 || command -v phpize || echo /usr/bin/phpize81)"
        PHP_CONFIG_BIN="$(command -v php-config81 || command -v php-config || echo /usr/bin/php-config81)"
        OCI8_PECL_SPEC="oci8-3.2.1"
        ;;
    8.2)
        APK_PHP_PREFIX="php82"
        PECL_BIN="$(command -v pecl82 || command -v pecl || echo /usr/bin/pecl82)"
        PHPIZE_BIN="$(command -v phpize82 || command -v phpize || echo /usr/bin/phpize82)"
        PHP_CONFIG_BIN="$(command -v php-config82 || command -v php-config || echo /usr/bin/php-config82)"
        OCI8_PECL_SPEC="oci8-3.2.1"
        ;;
    8.3)
        APK_PHP_PREFIX="php83"
        PECL_BIN="$(command -v pecl83 || command -v pecl || echo /usr/bin/pecl83)"
        PHPIZE_BIN="$(command -v phpize83 || command -v phpize || echo /usr/bin/phpize83)"
        PHP_CONFIG_BIN="$(command -v php-config83 || command -v php-config || echo /usr/bin/php-config83)"
        OCI8_PECL_SPEC="oci8-3.4.0"
        ;;
    8.4)
        APK_PHP_PREFIX="php84"
        PECL_BIN="$(command -v pecl84 || command -v pecl || echo /usr/bin/pecl84)"
        PHPIZE_BIN="$(command -v phpize84 || command -v phpize || echo /usr/bin/phpize84)"
        PHP_CONFIG_BIN="$(command -v php-config84 || command -v php-config || echo /usr/bin/php-config84)"
        OCI8_PECL_SPEC="oci8"
        ;;
    8.5)
        APK_PHP_PREFIX="php85"
        PECL_BIN="$(command -v pecl85 || command -v pecl || echo /usr/bin/pecl85)"
        PHPIZE_BIN="$(command -v phpize85 || command -v phpize || echo /usr/bin/phpize85)"
        PHP_CONFIG_BIN="$(command -v php-config85 || command -v php-config || echo /usr/bin/php-config85)"
        OCI8_PECL_SPEC="oci8"
        ;;
    *)
        APK_PHP_PREFIX="php"
        PECL_BIN="$(command -v pecl || echo /usr/bin/pecl)"
        PHPIZE_BIN="$(command -v phpize || echo /usr/bin/phpize)"
        PHP_CONFIG_BIN="$(command -v php-config || echo /usr/bin/php-config)"
        OCI8_PECL_SPEC="oci8"
        ;;
esac

safe_symlink() {
    src="$1"
    dst="$2"
    if [ -n "$src" ] && [ -e "$src" ] && [ "$src" != "$dst" ]; then
        if [ ! -L "$dst" ] || [ "$(readlink -f "$dst" 2>/dev/null)" != "$(readlink -f "$src" 2>/dev/null)" ]; then
            ln -sf "$src" "$dst" 2>/dev/null || true
        fi
    fi
}

# Create compatibility symlinks in both /usr/bin and /usr/local/bin
safe_symlink "$PHP_BIN" /usr/local/bin/php
safe_symlink "$PHP_BIN" /usr/bin/php
safe_symlink "$PHPIZE_BIN" /usr/local/bin/phpize
safe_symlink "$PHPIZE_BIN" /usr/bin/phpize
safe_symlink "$PHP_CONFIG_BIN" /usr/local/bin/php-config
safe_symlink "$PHP_CONFIG_BIN" /usr/bin/php-config
safe_symlink "$PECL_BIN" /usr/local/bin/pecl
safe_symlink "$PECL_BIN" /usr/bin/pecl

apk update

ensure_build_deps() {
    apk add --no-cache --virtual .php-ext-build-deps \
        autoconf \
        build-base \
        pkgconfig \
        linux-headers \
        "${APK_PHP_PREFIX}-dev" \
        "${APK_PHP_PREFIX}-pear" \
        openssl-dev \
        zlib-dev \
        pcre-dev \
        curl-dev
}

ensure_oracle_instantclient() {
    if [ ! -d "/opt/oracle/instantclient" ]; then
        echo "==> Installing Oracle Instant Client..."
        apk add --no-cache libaio libnsl libc6-compat gcompat wget unzip
        mkdir -p /opt/oracle
        cd /tmp
        wget -q https://download.oracle.com/otn_software/linux/instantclient/2117000/instantclient-basic-linux.x64-21.17.0.0.0dbru.zip
        wget -q https://download.oracle.com/otn_software/linux/instantclient/2117000/instantclient-sdk-linux.x64-21.17.0.0.0dbru.zip
        unzip -oq ./instantclient-basic-linux.x64-21.17.0.0.0dbru.zip -d /opt/oracle
        unzip -oq ./instantclient-sdk-linux.x64-21.17.0.0.0dbru.zip -d /opt/oracle
        rm -f instantclient-basic-linux.x64-21.17.0.0.0dbru.zip instantclient-sdk-linux.x64-21.17.0.0.0dbru.zip
        safe_symlink /opt/oracle/instantclient_21_17/sqlplus /usr/bin/sqlplus
        safe_symlink /opt/oracle/instantclient_21_17 /opt/oracle/instantclient
        safe_symlink /usr/lib/libnsl.so.2 /usr/lib/libnsl.so.1
        safe_symlink /lib/libc.musl-x86_64.so.1 /usr/lib/libresolv.so.2
        safe_symlink /lib/ld-musl-x86_64.so.1 /usr/lib/ld-linux-x86-64.so.2
    fi
    export LD_LIBRARY_PATH="/opt/oracle/instantclient:${LD_LIBRARY_PATH}"
}

run_pecl() {
    # Ensure PEAR/PECL executes PHP with disabled functions cleared (exec, popen, proc_open are needed during build)
    PHP_PEAR_PHP_BIN="$PHP_BIN -d disable_functions=\"\" -d memory_limit=\"-1\"" "$PECL_BIN" "$@"
}

PECL_UPDATED=0
ensure_pecl_updated() {
    if [ "$PECL_UPDATED" -eq 0 ]; then
        run_pecl channel-update pecl.php.net || true
        PECL_UPDATED=1
    fi
}

for EXT in "$@"; do
    EXT_BASE="${EXT%%-*}"
    EXT_LOWER="$(printf "%s" "$EXT_BASE" | tr '[:upper:]' '[:lower:]')"

    if "$PHP_BIN" -m | grep -qi "^${EXT_LOWER}$"; then
        echo "==> Extension '${EXT_LOWER}' is already installed and enabled."
        continue
    fi

    case "$EXT_LOWER" in
        oci8)
            ensure_build_deps
            ensure_oracle_instantclient
            ensure_pecl_updated
            echo "==> Installing ${OCI8_PECL_SPEC} via PECL..."
            printf "instantclient,/opt/oracle/instantclient\n" | run_pecl install "$OCI8_PECL_SPEC"
            docker-php-ext-enable oci8
            ;;
        *)
            # Try official Alpine package first (e.g. php81-redis, php7-soap, php82-xdebug)
            if apk add --no-cache "${APK_PHP_PREFIX}-${EXT_LOWER}" 2>/dev/null || apk add --no-cache "${APK_PHP_PREFIX}-pecl-${EXT_LOWER}" 2>/dev/null; then
                echo "==> Installed ${EXT_LOWER} via Alpine package."
            else
                echo "==> Installing ${EXT} via PECL..."
                ensure_build_deps
                ensure_pecl_updated
                printf "\n" | run_pecl install "$EXT"
                docker-php-ext-enable "$EXT_LOWER"
            fi
            ;;
    esac
done

# Cleanup temporary files, build deps, and purge apk for container hardening
rm -rf /tmp/pear /tmp/*
apk del .php-ext-build-deps 2>/dev/null || true
if [ "${KEEP_APK:-0}" != "1" ]; then
    apk del --purge apk-tools 2>/dev/null || true
    rm -rf /sbin/apk /usr/sbin/apk /etc/apk /lib/apk /usr/share/apk /var/cache/apk
fi

echo "✅ PHP extensions installed and enabled successfully: $*"
